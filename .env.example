UV_CACHE_DIR=.uv-cache
PYTHONPATH=packages/analyze-expenses-workflow/src;apps/analyze-expenses-workflow-app/src

# Select GITHUB_COPILOT or GPT_CODEX for later LLM steps.
CODING_ASSISTANT_SUBSCRIPTION=GPT_CODEX
# The SDK selects the model family: Codex and Copilot use OPENAI.
EXPENSE_LINE_EXTRACTION_OPENAI_MODEL=gpt-6-luna
EXPENSE_LINE_EXTRACTION_OPENAI_REASONING_EFFORT=low
EXPENSE_FINDINGS_OPENAI_MODEL=gpt-6-luna
EXPENSE_FINDINGS_OPENAI_REASONING_EFFORT=medium
# Reserved for a future LLM categorization fallback; Jev remains the active classifier.
EXPENSE_CATEGORIZATION_OPENAI_MODEL=gpt-6-luna
EXPENSE_CATEGORIZATION_OPENAI_REASONING_EFFORT=low

# Reserved for a future CLAUDE_CODE SDK gateway, which will select ANTHROPIC.
# EXPENSE_LINE_EXTRACTION_ANTHROPIC_MODEL=<available Claude model>
# EXPENSE_LINE_EXTRACTION_ANTHROPIC_REASONING_EFFORT=low
# EXPENSE_FINDINGS_ANTHROPIC_MODEL=<available Claude model>
# EXPENSE_FINDINGS_ANTHROPIC_REASONING_EFFORT=medium
# EXPENSE_CATEGORIZATION_ANTHROPIC_MODEL=<available Claude model>
# EXPENSE_CATEGORIZATION_ANTHROPIC_REASONING_EFFORT=low

# Example budgets from budget_notes.txt; override for a different analysis.
DINING_COFFEE_MONTHLY_BUDGET=260.00
SHOPPING_MONTHLY_BUDGET=1200.00

# Jev categorization uses the TypeSafe SDK through OpenRouter.
OPEN_ROUTER_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api
JEV_MODEL=jev-1.13
JEV_PARSING_MINIMUM_CHOICE_PROBABILITY=0.8
